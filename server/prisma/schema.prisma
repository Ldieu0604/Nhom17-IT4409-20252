generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PermissionRole {
  owner
  editor
  viewer
  commenter
}

enum DocumentTemplate {
  blank
  todo
  task_table
}

enum WorkspaceRole {
  owner
  member
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  WORKSPACE_INVITE
  WORKSPACE_JOINED
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String
  username       String   @unique
  firstname      String
  lastname       String
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedDocs                Document[]            @relation("DocumentOwner")
  permissions              Permission[]
  comments                 Comment[]
  snapshots                Snapshot[]
  sessions                 Session[]
  ownedWorkspaces          Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers         WorkspaceMember[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  notifications            Notification[]
  assignedTasks            Task[]                @relation("TaskAssignee")
  createdTasks             Task[]                @relation("TaskCreator")
  ownedCalendarEvents      CalendarEvent[]       @relation("CalendarEventOwner")
}

model Session {
  id                 String   @id @default(uuid())
  userID             String
  user               User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  expireAt           DateTime
  hashedRefreshToken String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userID])
  @@index([expireAt])
}

model Document {
  id              String           @id @default(uuid())
  title           String           @db.VarChar(200)
  snapshot        Bytes?
  snapshotVersion Int              @default(1)
  folderId        String?
  isStarred       Boolean          @default(false)
  template        DocumentTemplate @default(blank)
  workspaceId     String?
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation("DocumentOwner", fields: [ownerId], references: [id])

  isPublic   Boolean @default(false)
  publicRole String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  openedAt  DateTime @default(now())

  permissions    Permission[]
  comments       Comment[]
  snapshots      Snapshot[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([folderId])
  @@index([isStarred])
  @@index([openedAt])
  @@index([workspaceId])
}

model Workspace {
  id             String                @id @default(uuid())
  name           String                @db.VarChar(120)
  description    String?               @db.Text
  ownerId        String
  owner          User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  documents      Document[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String                    @id @default(uuid())
  workspaceId String
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole             @default(member)
  tokenHash   String                    @unique
  status      WorkspaceInvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User                      @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([email])
  @@index([workspaceId])
  @@index([invitedById])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model Task {
  id             String          @id @default(uuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title          String          @db.VarChar(240)
  description    String?         @db.Text
  assigneeId     String?
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User            @relation("TaskCreator", fields: [createdById], references: [id])
  status         TaskStatus      @default(todo)
  priority       TaskPriority    @default(medium)
  completed      Boolean         @default(false)
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  calendarEvents CalendarEvent[]

  @@index([workspaceId])
  @@index([documentId])
  @@index([assigneeId])
}

model CalendarEvent {
  id             String     @id @default(uuid())
  title          String     @db.VarChar(240)
  description    String?    @db.Text
  startAt        DateTime
  endAt          DateTime
  location       String?    @db.VarChar(240)
  meetingUrl     String?    @db.VarChar(500)
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  documentId     String?
  document       Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  ownerId        String
  owner          User       @relation("CalendarEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participantIds String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId])
  @@index([workspaceId])
  @@index([startAt])
}

model Permission {
  id        String         @id @default(uuid())
  role      PermissionRole
  grantedAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}

model Snapshot {
  id      String @id @default(uuid())
  version Int    @default(1)

  snapshotData Bytes

  createdAt DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])
}

model Comment {
  id           String @id @default(uuid())
  content      String @db.Text
  selectedText String @default("") @db.Text

  fromPos Int?
  toPos   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
